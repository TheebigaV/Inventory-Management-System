# ==========================================
# Root .gitignore for Inventory Management System
# ==========================================

# ------------------------------------------
# Environment & Secrets
# ------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------
# Python & AI Service Caches
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/
ENV/
*.venv

# ------------------------------------------
# Node.js & Next.js Frontend
# ------------------------------------------
node_modules/
frontend/node_modules/
backend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
*.tsbuildinfo
.vercel/

# ------------------------------------------
# PHP & Laravel Backend
# ------------------------------------------
vendor/
backend/vendor/
backend/storage/*.key
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*.log
backend/bootstrap/cache/*.php
backend/public/storage
backend/public/hot
backend/public/build
Homestead.json
Homestead.yaml
.phpunit.result.cache
.phpunit.cache/

# ------------------------------------------
# Logs & Debugging
# ------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------
# IDE & System OS Junk
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.user
*.userosmat
*.sln.docstates
*.swp
*.swo

# ------------------------------------------
# Temporary Files & Scripts
# ------------------------------------------
*.tmp
*.temp
scratch/
test_hash.php
check_users.php
